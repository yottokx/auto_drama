  "title": "雨の駅で、もう一度",
  "utterances": [
    {
      "audio_asset_id": null,
      "delivery": null,
      "display_text": "雨の駅。アキは、濡れた封筒をレンの前に差し出した。",
      "id": "line_001",
      "speaker_id": null,
      "spoken_text": "雨の駅。アキは、濡れた封筒をレンの前に差し出した。",
      "voice_emotion": "neutral"
    },
    {
      "audio_asset_id": null,
      "delivery": null,
      "display_text": "今さら戻れないよ。僕が壊したんだから。",
