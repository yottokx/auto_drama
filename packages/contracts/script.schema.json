            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Asset Id"
        },
        "framing": {
          "default": "auto",
          "enum": [
            "auto",
            "upper_body",
            "full_body"
          ],
          "title": "Framing",
          "type": "string"
        },
        "height_cm": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Cm"
        },
        "body_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortraitBounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "offset_y": {
          "default": 0,
          "maximum": 640,
          "minimum": -640,
          "title": "Offset Y",
          "type": "number"
        },
        "scale": {
          "default": 1,
          "maximum": 3,
          "minimum": 0.1,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Character",
      "type": "object"
    },
