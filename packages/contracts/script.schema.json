  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/Character"
      },
      "maxItems": 100,
      "title": "Characters",
      "type": "array"
    },
    "utterances": {
      "items": {
        "$ref": "#/$defs/Utterance"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Utterances",
      "type": "array"
    },
    "directions": {
      "items": {
        "discriminator": {
          "mapping": {
            "background": "#/$defs/BackgroundDirection",
            "blackout": "#/$defs/BlackoutDirection",
            "enter": "#/$defs/EnterDirection",
            "exit": "#/$defs/ExitDirection",
            "focus": "#/$defs/FocusDirection",
            "pause": "#/$defs/PauseDirection",
            "position": "#/$defs/PositionDirection"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BackgroundDirection"
          },
          {
            "$ref": "#/$defs/EnterDirection"
          },
          {
            "$ref": "#/$defs/ExitDirection"
          },
          {
            "$ref": "#/$defs/PositionDirection"
          },
          {
            "$ref": "#/$defs/FocusDirection"
          },
          {
            "$ref": "#/$defs/BlackoutDirection"
          },
          {
            "$ref": "#/$defs/PauseDirection"
          }
        ]
      },
      "maxItems": 50000,
      "title": "Directions",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetReference"
      },
      "maxItems": 20000,
      "title": "Assets",
      "type": "array"
    },
    "portrait_baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/PortraitBaseline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "title",
    "utterances"
  ],
  "title": "Script",
  "type": "object"
}
