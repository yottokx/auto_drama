    "PortraitBaseline": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "pixels_per_cm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixels Per Cm"
        },
        "ground_y": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": -1000000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ground Y"
        },
        "layouts": {
          "maxProperties": 100,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$": {
              "$ref": "#/$defs/PortraitGeometry"
            }
          },
          "title": "Layouts",
          "type": "object"
        }
      },
      "title": "PortraitBaseline",
      "type": "object"
    },
