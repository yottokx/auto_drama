          "title": "Timing",
          "type": "string"
        },
        "kind": {
          "const": "background",
          "title": "Kind",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "duration_ms": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "utterance_id",
        "kind",
        "asset_id"
      ],
      "title": "BackgroundDirection",
      "type": "object"
    },
    "BlackoutDirection": {
      "additionalProperties": false,
      "description": "Fade to black, then fade back in; duration is per fade, in milliseconds.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "utterance_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Utterance Id",
          "type": "string"
        },
        "timing": {
          "default": "before",
          "enum": [
            "before",
            "start",
            "after"
          ],
          "title": "Timing",
          "type": "string"
        },
        "kind": {
          "const": "blackout",
          "title": "Kind",
          "type": "string"
        },
        "duration_ms": {
          "default": 300,
          "maximum": 10000,
          "minimum": 1,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "utterance_id",
        "kind"
      ],
      "title": "BlackoutDirection",
      "type": "object"
    },
    "Character": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "image_asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
