{
  "$defs": {
    "AssetReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "background",
            "character",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "filename": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "artifact_id",
        "filename",
        "sha256"
      ],
      "title": "AssetReference",
      "type": "object"
    },
    "BackgroundDirection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "utterance_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Utterance Id",
          "type": "string"
