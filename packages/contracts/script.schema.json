          "maxLength": 100000,
          "minLength": 1,
          "title": "Display Text",
          "type": "string"
        },
        "spoken_text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Spoken Text",
          "type": "string"
        },
        "voice_emotion": {
          "default": "neutral",
          "maxLength": 80,
          "minLength": 1,
          "title": "Voice Emotion",
          "type": "string"
        },
        "delivery": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
